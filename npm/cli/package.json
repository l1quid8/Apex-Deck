{
  "name": "@apex-deck/cli",
  "version": "0.9.15",
  "description": "Apex Deck standalone CLI launcher - shares agents and threads with the desktop app. macOS needs one-time admin setup; Linux needs none.",
  "bin": {
    "apex": "bin/apex"
  },
  "files": [
    "bin/"
  ],
  "optionalDependencies": {
    "@apex-deck/cli-darwin-arm64": "0.9.15",
    "@apex-deck/cli-linux-x64": "0.9.15"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/apex-deck/apex-deck"
  },
  "preferGlobal": true,
  "publishConfig": {
    "access": "public"
  }
}
